# ─── Supabase ────────────────────────────────────────────────────────────────

# Runtime connection — pooled Transaction mode, port 6543 (used by the web app on Vercel)
DATABASE_URL=postgresql://postgres.YOURREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Migration/introspection — direct connection, port 5432 (drizzle-kit only, never deployed)
DIRECT_URL=postgresql://postgres.YOURREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── Phase 2: NextAuth + Discord OAuth ───────────────────────────────────────
# NEXTAUTH_URL=https://your-vercel-url.vercel.app
# NEXTAUTH_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
